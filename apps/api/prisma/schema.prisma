generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
}

enum PropertyType {
  FARMHOUSE
  VILLA
  PARTY_HOUSE
  POOL_PROPERTY
  WEEKEND_STAY
  EVENT_VENUE
}

enum PropertyStatus {
  DRAFT
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum PaymentProviderType {
  // Earlier gateways stay so the rows written under them remain readable.
  // New payments are PHONEPE.
  RAZORPAY
  PAYU
  INSTAMOJO
  PHONEPE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum KycStatus {
  NOT_SUBMITTED
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DocumentStatus {
  UPLOADED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String
  name            String
  role            UserRole  @default(CUSTOMER)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownerProfile           OwnerProfile?
  properties             Property[]
  bookings               Booking[]                 @relation("CustomerBookings")
  reviews                Review[]
  wishlistItems          WishlistItem[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  supportTickets         SupportTicket[]
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  agreementsAuthored     HostAgreement[]
  agreementAcceptances   HostAgreementAcceptance[]
  otpChallenges          OtpChallenge[]

  @@index([role])
  @@index([isActive])
}

model OwnerProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  businessName String?
  gstNumber    String?
  panNumber    String?
  kycVerified  Boolean @default(false)

  // Identity verification for hosts.
  // The raw Aadhaar number is deliberately NOT stored: India's Aadhaar Act
  // restricts retention of the full number, so we keep only the last four
  // digits for display plus a keyed hash for duplicate detection. The uploaded
  // image is what a reviewer actually checks against.
  panImageUrl       String?
  aadhaarLast4      String?
  aadhaarHash       String?
  aadhaarImageUrl   String?
  // Payout destination for host earnings. Distinct from refunds, which always
  // return to the guest's original payment method via the gateway.
  bankAccountName   String?
  bankAccountNumber String?
  bankAccountLast4  String?
  bankIfsc          String?
  bankName          String?

  kycStatus          KycStatus @default(NOT_SUBMITTED)
  kycSubmittedAt     DateTime?
  kycReviewedAt      DateTime?
  kycRejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts OwnerPayout[]
}

/// Runtime configuration an admin can change without a redeploy.
/// Values fall back to the matching environment variable when no row exists.
model PlatformSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Property {
  id                 String       @id @default(uuid())
  ownerId            String
  title              String
  slug               String       @unique
  description        String       @db.Text
  propertyType       PropertyType
  location           String
  city               String
  state              String
  country            String       @default("India")
  pincode            String?
  address            String
  latitude           Decimal      @db.Decimal(10, 7)
  longitude          Decimal      @db.Decimal(10, 7)
  guestCapacity      Int
  bedrooms           Int
  bathrooms          Int
  basePrice          Decimal      @db.Decimal(12, 2)
  weekendPrice       Decimal?     @db.Decimal(12, 2)
  extraGuestCharge   Decimal?     @db.Decimal(12, 2)
  partyRules         String?      @db.Text
  propertyRules      String?      @db.Text
  cancellationPolicy String?      @db.Text
  isPartyFriendly    Boolean      @default(false)
  isAdultOnly        Boolean      @default(false)
  isCoupleFriendly   Boolean      @default(false)

  // Awarded by an admin after a manual check, never set by the host. It is
  // deliberately absent from CreatePropertyDto and UpdatePropertyDto, so a host
  // sending `isTrusted` is rejected outright by the global validation pipe
  // rather than having the field quietly ignored.
  isTrusted     Boolean        @default(false)
  trustedAt     DateTime?
  averageRating Decimal        @default(0) @db.Decimal(3, 2)
  reviewCount   Int            @default(0)
  status        PropertyStatus @default(DRAFT)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner                User                      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  images               PropertyImage[]
  amenities            PropertyAmenity[]
  availability         Availability[]
  bookings             Booking[]
  reviews              Review[]
  wishlistItems        WishlistItem[]
  documents            PropertyDocument[]
  bookingNights        BookingNight[]
  agreementAcceptances HostAgreementAcceptance[]

  @@index([city, status])
  @@index([state])
  @@index([country])
  @@index([propertyType, status])
  @@index([ownerId])
  @@index([status])
  @@index([status, isPartyFriendly])
  @@index([status, basePrice])
  @@index([status, averageRating])
  @@index([status, createdAt])
  @@index([status, isTrusted])
  @@index([latitude, longitude])
  @@index([deletedAt])
  @@index([pincode])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  publicId   String?
  altText    String?
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Amenity {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

model Availability {
  id         String             @id @default(uuid())
  propertyId String
  date       DateTime           @db.Date
  status     AvailabilityStatus @default(AVAILABLE)
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@index([date, status])
  @@index([propertyId, status, date])
}

/// Night-level lock used to prevent double booking at the database layer.
/// Inserting overlapping CONFIRMED/PENDING nights for the same property fails uniqueness.
model BookingNight {
  id         String   @id @default(uuid())
  bookingId  String
  propertyId String
  date       DateTime @db.Date

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, date])
  @@index([bookingId])
}

model Booking {
  id               String        @id @default(uuid())
  customerId       String
  propertyId       String
  couponId         String?
  checkInDate      DateTime      @db.Date
  checkOutDate     DateTime      @db.Date
  guestCount       Int
  baseAmount       Decimal       @db.Decimal(12, 2)
  weekendAmount    Decimal       @default(0) @db.Decimal(12, 2)
  extraGuestAmount Decimal       @default(0) @db.Decimal(12, 2)
  platformFee      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR")
  status           BookingStatus @default(PENDING)
  cancelledAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer   User           @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  coupon     Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  nights     BookingNight[]
  payments   Payment[]
  review     Review?
  refunds    Refund[]
  commission Commission?

  @@index([customerId, status])
  @@index([propertyId, status])
  @@index([checkInDate, checkOutDate])
  @@index([status])
  @@index([couponId])
}

model Payment {
  id                String              @id @default(uuid())
  bookingId         String
  provider          PaymentProviderType @default(PHONEPE)
  providerPaymentId String?
  providerOrderId   String?
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("INR")
  status            PaymentStatus       @default(CREATED)
  verifiedAt        DateTime?
  failureReason     String?
  expiresAt         DateTime?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@unique([provider, providerOrderId])
  @@index([bookingId])
  @@index([status])
  @@index([expiresAt, status])
}

model Review {
  id               String    @id @default(uuid())
  bookingId        String    @unique
  propertyId       String
  customerId       String
  rating           Int
  comment          String?   @db.Text
  ownerResponse    String?   @db.Text
  ownerRespondedAt DateTime?
  isPublished      Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customer User     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([propertyId, isPublished])
  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String    @db.Text
  readAt    DateTime?
  metadata  Json?
  dedupeKey String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  bookingConfirmation Boolean  @default(true)
  paymentSuccess      Boolean  @default(true)
  paymentFailure      Boolean  @default(true)
  cancellation        Boolean  @default(true)
  refund              Boolean  @default(true)
  propertyApproval    Boolean  @default(true)
  propertyRejection   Boolean  @default(true)
  newReview           Boolean  @default(true)
  coupon              Boolean  @default(true)
  // WhatsApp needs the customer's explicit opt-in (Meta policy), so it is off
  // until they turn it on, and only ever sent to a verified phone.
  whatsapp            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id        String                @id @default(uuid())
  userId    String
  subject   String
  message   String                @db.Text
  status    SupportTicketStatus   @default(OPEN)
  priority  SupportTicketPriority @default(MEDIUM)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, priority])
}

model Coupon {
  id                    String       @id @default(uuid())
  code                  String       @unique
  description           String?
  discountType          DiscountType
  discountValue         Decimal      @db.Decimal(12, 2)
  maxDiscount           Decimal?     @db.Decimal(12, 2)
  minBookingAmount      Decimal?     @db.Decimal(12, 2)
  startsAt              DateTime
  endsAt                DateTime
  maxRedemptions        Int?
  maxRedemptionsPerUser Int?
  redemptionCount       Int          @default(0)
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  bookings Booking[]

  @@index([isActive, startsAt, endsAt])
}

model OtpChallenge {
  id           String    @id @default(uuid())
  phone        String
  purpose      String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  lastSentAt   DateTime  @default(now())
  ipAddress    String?
  userId       String?
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  familyId     String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model OwnerPayout {
  id             String       @id @default(uuid())
  ownerProfileId String
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  status         PayoutStatus @default(PENDING)
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  processedAt    DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ownerProfile OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Restrict)

  @@index([ownerProfileId, status])
}

model Commission {
  id        String   @id @default(uuid())
  bookingId String   @unique
  rateBps   Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model Refund {
  id               String       @id @default(uuid())
  bookingId        String
  paymentId        String
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?
  status           RefundStatus @default(REQUESTED)
  providerRefundId String?
  providerStatus   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([providerRefundId])
  @@index([bookingId])
  @@index([paymentId])
  @@index([status])
}

model ProcessedWebhookEvent {
  id        String   @id
  event     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model PropertyDocument {
  id           String         @id @default(uuid())
  propertyId   String
  name         String
  documentType String
  url          String
  status       DocumentStatus @default(UPLOADED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
}

// --- Host agreement ----------------------------------------------------------
//
// The terms a host signs before a listing can be submitted for approval:
// bookings, money transfer, payouts and the rest. Only an admin writes it.
// Every save is a new version and the old ones are never edited or deleted,
// because a signature means "I agreed to *this* text" — an acceptance row
// points at the exact version that was on screen when the host signed.
model HostAgreement {
  id          String   @id @default(uuid())
  version     Int      @unique
  title       String
  body        String   @db.Text
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById String?

  createdBy   User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  acceptances HostAgreementAcceptance[]

  @@index([isActive])
}

// One row per (agreement version, property). Submitting a listing requires a
// row for the currently active version, so a host who signed an older text is
// asked to sign again when the admin changes it.
model HostAgreementAcceptance {
  id            String   @id @default(uuid())
  agreementId   String
  userId        String
  propertyId    String
  // The name the host typed as their signature, kept exactly as typed.
  signatureName String
  ipAddress     String?
  userAgent     String?
  acceptedAt    DateTime @default(now())

  agreement HostAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property  Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([agreementId, propertyId])
  @@index([propertyId])
  @@index([userId])
}

// Monthly plans a host can subscribe to for listing properties. Admins author
// them; the host dashboard shows the active ones as a price list. Subscribing
// happens off-site for now (the host contacts the team), so nothing here
// records which host picked which plan and listing creation is not limited by
// it.
model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  description  String?
  monthlyPrice Decimal  @db.Decimal(12, 2)
  // Listings the plan covers; null means unlimited.
  listingLimit Int?
  // Shown as a bullet list on the plan card, in this order.
  features     String[]
  isActive     Boolean  @default(true)
  // Highlights the card as the recommended plan.
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
}
