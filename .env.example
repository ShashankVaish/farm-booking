NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=farmhouse
POSTGRES_PASSWORD=farmhouse_dev_password
POSTGRES_DB=farmhouse
POSTGRES_PORT=5432
DATABASE_URL=postgresql://farmhouse:farmhouse_dev_password@localhost:5432/farmhouse?schema=public

# Auth — generate unique 32+ character secrets for every environment
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# Frontend (apps/web) — public values only
# NEXT_PUBLIC_BRAND_NAME=BRAND_NAME
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10

# Pricing (500 = 5.00%)
PLATFORM_FEE_BPS=500
BOOKING_EXPIRE_MINUTES=30

# Maps / geocoding — server only
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=

# SMS / OTP — server only (never send these to the frontend)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_PEPPER=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# Razorpay — server only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
