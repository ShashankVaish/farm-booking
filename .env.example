# ============================================================
# Baagly — template for the single root .env.
# Loaded by: the API (NestJS ConfigModule), the web app
# (apps/web/next.config.ts), Prisma CLI, and docker-compose.
# Copy to .env and fill in real values. Never commit the .env itself.
# ============================================================

# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=farmhouse
POSTGRES_PASSWORD=farmhouse_dev_password
POSTGRES_DB=farmhouse
POSTGRES_PORT=5432
DATABASE_URL=postgresql://farmhouse:farmhouse_dev_password@localhost:5432/farmhouse?schema=public

# Auth / JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10

# Pricing & bookings
PLATFORM_FEE_BPS=500

# Bootstrap admin
ADMIN_EMAIL=admin
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
WEB_APP_URL=http://localhost:3000

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend (public — never put secrets in NEXT_PUBLIC_*)
NEXT_PUBLIC_BRAND_NAME=Baagly
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bookings
# Abandoned unpaid bookings expire after this many minutes
BOOKING_EXPIRE_MINUTES=30

# Maps / geocoding (server-side only). nominatim | google | manual
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=

# SMS / OTP (never expose these to the frontend)
# console | twilio | renflair
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Renflair (non-DLT, India only) — key from the Renflair dashboard
RENFLAIR_API_KEY=
OTP_PEPPER=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# Redis — OTP challenges, cooldowns and send-rate counters.
# Runs in the WSL Docker container `farmhouse-redis` (docker compose up -d redis).
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Email (SMTP). Used for signup email OTP, booking confirmations and the
# awaiting-payment reminder.
#
# MAIL_PROVIDER=smtp sends for real; `console` only logs the rendered message,
# which is what the test suite and a bare dev machine should use.
#
# Port 465 uses implicit TLS; 587 switches to STARTTLS automatically.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Baagly
MAIL_FROM_ADDRESS=no-reply@example.com
