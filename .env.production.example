# =============================================================================
# Production environment for the API server.
#
# Copy to `.env.production` on the Ubuntu server and fill in real values:
#   cp .env.production.example .env.production && nano .env.production
#
# This file is read by docker-compose.prod.yml. It must never be committed —
# `.env.production` is gitignored alongside `.env`.
#
# Generate every secret below with:  openssl rand -base64 48
# =============================================================================

NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# --- Database and Redis -----------------------------------------------------
# The first three create the Postgres container. DATABASE_URL is what the API
# connects with, so the user, password and database name in it MUST match them.
#
# The hostnames `postgres` and `redis` are Docker service names, resolved on the
# internal network — not localhost. Leave them exactly as they are.
POSTGRES_USER=baagly
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=baagly

DATABASE_URL=postgresql://baagly:CHANGE_ME_long_random_password@postgres:5432/baagly?schema=public
REDIS_URL=redis://redis:6379

# --- Auth -------------------------------------------------------------------
# Both must be at least 32 characters, and different from each other.
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_different_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# HTTPS only in production, so refresh cookies must be secure.
COOKIE_SECURE=true

# --- Networking -------------------------------------------------------------
# The site Vercel serves. Used for CORS, for links in emails, and for the
# redirect back from Google sign-in. No trailing slash.
CORS_ORIGIN=https://baagly.com,https://www.baagly.com
WEB_APP_URL=https://www.baagly.com

# One Nginx sits in front of the API, so trust exactly one proxy hop. Without
# this every request looks like it came from Nginx and rate limiting collapses
# into a single bucket shared by all users.
TRUST_PROXY_HOPS=1

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=20

# --- Platform ---------------------------------------------------------------
PLATFORM_FEE_BPS=500
BOOKING_EXPIRE_MINUTES=30

# --- First admin ------------------------------------------------------------
# Created on first boot. Change the password immediately after signing in.
ADMIN_EMAIL=admin@baagly.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_NAME=Baagly Admin

# --- Google sign-in ---------------------------------------------------------
# The redirect URI must match the one registered in Google Cloud Console
# exactly, including the scheme and path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MUST be on the same host the site runs on, NOT the API host. The browser
# starts sign-in at https://www.baagly.com/api/auth/google, which Next rewrites
# to the API — so the state cookie is stored for www.baagly.com. If Google
# returned to api.baagly.com that cookie would not be sent and every sign-in
# would fail. (This is invisible locally: localhost:3000 and localhost:3001
# share a cookie jar, because cookies ignore the port.)
GOOGLE_OAUTH_REDIRECT_URI=https://www.baagly.com/api/auth/google/callback

# --- Payments ---------------------------------------------------------------
# Swap the test keys for live keys when you are ready to take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Geocoding --------------------------------------------------------------
# Nominatim needs no key. Switch to `google` only once the Geocoding API is
# enabled and billed on the Google Cloud project.
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=

# --- Email ------------------------------------------------------------------
MAIL_PROVIDER=smtp
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@baagly.com
SMTP_PASS=
MAIL_FROM_NAME=Baagly
MAIL_FROM_ADDRESS=info@baagly.com

# --- SMS (mobile OTP) -------------------------------------------------------
# `console` only logs codes. Set to `renflair` or `twilio` with credentials.
SMS_PROVIDER=console
RENFLAIR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- OTP --------------------------------------------------------------------
OTP_PEPPER=CHANGE_ME_openssl_rand_base64_48
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
